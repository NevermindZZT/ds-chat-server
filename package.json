{
  "name": "ds-chat-server",
  "version": "0.2.4",
  "description": "Self-hosted DeepSeek Chat with MCP, Skills, and a DSH plugin.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build && concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "NODE_ENV=development rspack build --watch -c rspack.config.ts",
    "build": "NODE_ENV=production rspack build -c rspack.config.ts",
    "start": "node server/index.js",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src server rspack.config.ts",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "better-sqlite3": "^13.2.0",
    "clsx": "2.1.1",
    "fastify": "^5.2.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NevermindZZT/ds-chat-server.git"
  },
  "homepage": "https://github.com/NevermindZZT/ds-chat-server#readme",
  "bugs": {
    "url": "https://github.com/NevermindZZT/ds-chat-server/issues"
  },
  "keywords": [
    "deepseek",
    "chat",
    "dsh",
    "mcp",
    "skills",
    "self-hosted"
  ]
}
