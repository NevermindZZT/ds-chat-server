# SQLite database, uploads, Skills, and generated secret are stored under the chat_data volume.
CHAT_SERVER_PORT=8080

# First-run admin account. The app forces a password change after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: use a server-managed key instead of entering one in Settings.
# DEEPSEEK_API_KEY=

# Optional. If omitted, a random persistent secret is created under the chat_data volume.
# APP_SECRET=

# Context window used for context-ratio metrics and auto-compaction estimates.
DEEPSEEK_CONTEXT_WINDOW=128000

# Set COOKIE_SECURE=true when serving through HTTPS. Set TRUST_PROXY=true behind a trusted reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false

# stdio MCP is disabled unless commands are explicitly allowlisted, e.g. ["uvx","npx"].
MCP_STDIO_ALLOWLIST=[]
MCP_STDIO_CWD_ROOT=/data
